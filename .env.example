# Database
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://broker_admin:your_postgres_password_here@localhost:5433/broker_crm?schema=public

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars_min
BETTER_AUTH_URL=http://localhost:3000

# Application Base URL (used for links generated in emails)
APP_BASE_URL=http://localhost:3000

# SMTP / Email Configuration (Mailpit defaults for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Broker CRM <notifications@broker-crm.internal>"

